# Copy this file to terraform.tfvars and edit to match your environment.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "eu-west-1"
project_name = "bedrock-agent-blueprint"
environment  = "dev"

# Cloud agent workspace settings
agent_name    = "bedrock_agent_blueprint"
container_tag = "latest"
model_id      = "eu.anthropic.claude-sonnet-5"
log_level     = "INFO"

# Optional GitHub Actions OIDC deploy role.
# Set github_actions_oidc_enabled = true after replacing github_repository.
github_actions_oidc_enabled = false
github_repository           = "owner/repo"
github_oidc_provider_arn    = "" # set if your AWS account already has a GitHub OIDC provider
github_deploy_branch        = "main"

# Optional remote Terraform state settings used by CI/CD workflows.
# Create infra/backend.tf from infra/backend.tf.example before relying on these.
terraform_state_bucket = "replace-with-your-tfstate-bucket"
terraform_state_key    = "bedrock-agent-blueprint/dev/terraform.tfstate"
